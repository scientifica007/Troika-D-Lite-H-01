#!/usr/bin/env python3
"""Run the Troika D Lite media self-test from a source checkout."""

from __future__ import annotations

import sys
from pathlib import Path

_REPO_ROOT = Path(__file__).resolve().parent.parent
_SRC = _REPO_ROOT / "src"
if (_SRC / "troika").is_dir() and str(_SRC) not in sys.path:
    sys.path.insert(0, str(_SRC))

from troika.interpreter import ensure_gi_capable_interpreter  # noqa: E402

# Same re-exec as the GUI launcher: the self-test needs the system ``gi`` too.
ensure_gi_capable_interpreter()

from troika.selftest import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
